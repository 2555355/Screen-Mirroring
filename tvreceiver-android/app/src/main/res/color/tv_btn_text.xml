<?xml version="1.0" encoding="utf-8"?>
<!-- 按钮文字颜色随焦点/选中状态变化，配合 tv_btn_selector 使用 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="#FFFFFFFF" />
    <item android:state_focused="true" android:color="#FFFFC107" />
    <item android:state_pressed="true" android:color="#FFFFFFFF" />
    <item android:color="#FFCFD8DC" />
</selector>
